        "id": "orchestration",
        "label": "orchestration: DAG scheduling",
        "focus": [
          "main",
          "coord",
          "sqlite",
          "agents"
        ],
        "note": "The coordinator persists identity, tasks, dependencies and leases only. Workers are still launched by the ZCode Agent tool."
      },
      {
        "id": "graph",
        "label": "graph: semantic retrieval",
        "focus": [
          "main",
          "cg",
          "cgidx",
          "explore"
        ],
        "note": "One codegraph_explore round trip returns source plus call chains. A missing binary or an index older than HEAD degrades to Explore."
      },
      {
        "id": "fallback",
        "label": "three fallback chains",
        "focus": [
          "gui",
          "dash",
          "coord",
          "state",
          "cg",
          "explore"
        ],
        "note": "Each optional layer degrades only itself: dashboard to the GUI panel, orchestration to .omz/runtime files, graph to built-in Explore."
      }
    ]
